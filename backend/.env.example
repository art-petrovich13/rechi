APP_NAME=Rechi API
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
# Swagger на /docs. В production оставлять false.
DOCS_ENABLED=false

BOT_TOKEN=
PUBLIC_URL=
# Секрет webhook. Если пусто, выводится из BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

SPEECH_SUPER_KEY=
SPEECH_SUPER_SECRET=
SPEECH_SUPER_URL=https://api.speechsuper.com
SPEECH_SUPER_TIMEOUT_SECONDS=30
# 0 отключает лимит.
ASSESS_PER_MINUTE_LIMIT=8
ASSESS_DAILY_LIMIT=200
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rechi
